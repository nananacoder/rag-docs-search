# Copy to .env for local dev. Pydantic-settings reads from .env automatically.

APP_ENV=dev
LOG_LEVEL=INFO

# Which retrieval implementation to use. "mock" for local no-GCP dev.
# In Phase 1 switch to "discovery_engine"; Phase 2 adds "pgvector".
RETRIEVAL_BACKEND=mock

# GCP project + location — only required when backend != "mock"
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# Corpus PDF in GCS, streamed to the browser via /api/pdf/{name}
PDF_GCS_URI=gs://my-rag-docs-bucket-123/astronomy-2e.pdf

# Vertex AI Search (Phase 1)
DISCOVERY_ENGINE_DATASTORE_ID=
DISCOVERY_ENGINE_ENGINE_ID=
DISCOVERY_ENGINE_COLLECTION=default_collection

# Phase 2 — Cloud SQL + pgvector
# cloudsql = cloud-sql-python-connector + IAM auth (needs GCP_PROJECT_ID + DB_IAM_USER)
# direct   = plain asyncpg DSN below (CI / local docker Postgres)
DB_MODE=cloudsql
DB_INSTANCE=rag-pg
DB_NAME=rag
DB_IAM_USER=
# direct mode only, e.g. postgresql://postgres:postgres@localhost:5433/rag
DATABASE_URL=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Generation
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-pro
GENERATION_TEMPERATURE=0.2

# Retrieval shape
DEFAULT_TOP_K=5
MAX_TOP_K=20

# CORS origins (comma-separated). Angular dev server in local dev.
CORS_ORIGINS=http://localhost:4200
